{
  "name": "dsh-agenttask",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "description": "dsh-AgentTask: 纯任务监视(胶囊 x/y + 面板三段 + 点击跳转), 全端可用",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agent",
    "plugin",
    "monitor"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "index.d.ts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "SKILL.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
